{
	"$schema": "/etc/xdg/swaync/configSchema.json",
	"positionX": "right",
	"positionY": "top",
	"layer": "overlay",
	"control-center-margin-top": 20,
	"control-center-margin-bottom": 20,
	"control-center-margin-right": 20,
	"control-center-margin-left": 20,
	"notification-icon-size": 64,
	"notification-body-image-height": 100,
	"notification-body-image-width": 200,
	"timeout": 3,
	"timeout-low": 2,
	"timeout-critical": 0,
	"fit-to-screen": true,
	"control-center-width": 400,
	"keyboard-shortcuts": true,
	"image-visibility": "when-available",
	"transition-time": 200,
	"hide-on-clear": true,
	"hide-on-action": true,
	"script-fail-notify": true,
	"widgets": ["title", "notifications", "dnd", "mpris", "volume", "buttons-grid"],
	"widget-config": {
		"title":  {
			"text": "Notifications",
			"clear-all-button": true,
			"button-text": "  Clear All"
		},
		"dnd": {
			"text": "Do Not Disturb"
		},
		"label": {
			"max-lines": 1,
			"text": "Notifications"
		},
		"mpris": {
			"image-size": 96,
			"image-radius": 0
		},
		"backlight": {
			"label": "󰃟"
		},
		"volume": {
			"label": "󰕾",
			"show-per-app": true
		},
		"buttons-grid": {
			"actions": [
				{
					"label": "󰕾",
					"command": "wpctl set-mute @DEFAULT_SINK@ toggle"
				},
				{
					"label": "󰍬",
					"command": "wpctl set-mute @DEFAULT_SOURCE@ toggle"
				},
				{
					"label": "󰂯",
					"command": "swaync-client -cp && kitty --class=\"kitty-waybar-tool\" bluetuith"
				}
			]
		}
	}
}
